{
  "name": "micole-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/billing.test.ts tests/database.test.ts tests/reports.test.ts tests/reports-database.test.ts tests/institution-identity.test.ts tests/public-institutions.test.ts tests/student-access-database.test.ts tests/auth-errors.test.ts tests/operations-database.test.ts tests/operations.test.ts",
    "test:e2e": "playwright test",
    "supabase:smoke:students": "node scripts/smoke-student-access.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "supabase:migrate:students": "node scripts/migrate-student-access.mjs --apply",
    "supabase:setup": "node scripts/setup-supabase.mjs",
    "supabase:verify": "node scripts/verify-supabase.mjs",
    "supabase:smoke": "node scripts/smoke-supabase.mjs",
    "supabase:smoke:reports": "node scripts/smoke-reports.mjs",
    "supabase:smoke:institutions": "node scripts/smoke-institutions.mjs",
    "supabase:smoke:operations": "node scripts/smoke-operations.mjs",
    "supabase:migrate:operations": "node scripts/migrate-operations.mjs --apply"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.468.0",
    "motion": "^14.2.0",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.4"
  }
}
