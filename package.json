{
  "name": "micole-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/billing.test.ts tests/database.test.ts tests/reports.test.ts tests/reports-database.test.ts tests/institution-identity.test.ts tests/public-institutions.test.ts tests/student-access-database.test.ts tests/auth-errors.test.ts tests/operations-database.test.ts tests/operations.test.ts tests/push-database.test.ts tests/push-message.test.ts tests/learning-database.test.ts tests/learning.test.ts tests/owner-test-workspace.test.ts tests/baneco-database.test.ts tests/baneco.test.ts tests/pricing-database.test.ts tests/r2-origins.test.ts tests/school-database.test.ts tests/school.test.ts tests/demo.test.ts",
    "test:e2e": "playwright test",
    "supabase:smoke:students": "node scripts/smoke-student-access.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "supabase:migrate:students": "node scripts/migrate-student-access.mjs --apply",
    "supabase:setup": "node scripts/setup-supabase.mjs",
    "supabase:verify": "node scripts/verify-supabase.mjs",
    "supabase:smoke": "node scripts/smoke-supabase.mjs",
    "supabase:smoke:reports": "node scripts/smoke-reports.mjs",
    "supabase:smoke:institutions": "node scripts/smoke-institutions.mjs",
    "supabase:smoke:operations": "node scripts/smoke-operations.mjs",
    "supabase:migrate:operations": "node scripts/migrate-operations.mjs --apply",
    "supabase:setup:push": "node scripts/setup-push.mjs --apply",
    "supabase:migrate:learning": "node scripts/migrate-learning.mjs --apply",
    "supabase:smoke:learning": "node scripts/smoke-learning.mjs",
    "supabase:migrate:testing": "node scripts/migrate-testing.mjs --apply",
    "supabase:migrate:bank": "node scripts/migrate-bank.mjs --apply",
    "supabase:setup:bank": "node scripts/setup-bank.mjs --apply",
    "supabase:smoke:bank": "node scripts/smoke-bank.mjs",
    "supabase:migrate:pricing": "node scripts/migrate-pricing.mjs --apply",
    "supabase:smoke:pricing": "node scripts/smoke-pricing.mjs",
    "supabase:setup:r2": "node scripts/setup-r2.mjs --apply",
    "supabase:verify:r2": "node scripts/setup-r2.mjs",
    "supabase:migrate:school": "node scripts/migrate-school.mjs --apply",
    "supabase:smoke:school": "node scripts/smoke-school.mjs",
    "demo:build": "node scripts/build-demo.mjs",
    "test:demo": "npm run demo:build && playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.468.0",
    "motion": "^14.2.0",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.4"
  }
}
