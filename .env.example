# live: Supabase real. demo: ejemplos guardados en este navegador.
VITE_APP_MODE=live
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Activar después de configurar y desplegar r2-media.
VITE_R2_ENABLED=false
# Solo scripts de administración. Nunca usar estas variables con prefijo VITE_.
SUPABASE_DB_PASSWORD=
MICOLE_ADMIN_EMAIL=

# Opcional y público: Maps Embed API. Restringir a los dominios y a esa API.
# Alternativa sin clave: pegar la URL de Google Maps → Compartir → Insertar mapa.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Demo comercial: usar npm run demo:build y desplegar en su propio proyecto.
# No activar esta opción en la aplicación real.
VITE_PUBLIC_DEMO=false
# URL pública de la demo, usada por /demo y la landing.
VITE_DEMO_URL=https://micole-demo.vercel.app
